{
  // Cloudflare-Konfiguration für J.A.R.V.I.S.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",

  // Die Oberfläche (Ordner public/) wird direkt von Cloudflare ausgeliefert.
  // Alles unter /api/ läuft zuerst durch unser Backend.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Zugriff auf Cloudflare Workers AI (Gratis-Kontingent: 10.000 Neurons pro Tag)
  "ai": { "binding": "AI" },

  "vars": {
    // Hauptmodell und Ersatzmodell. Kann später im Cloudflare-Dashboard geändert werden.
    "MODEL_PRIMARY": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "MODEL_FALLBACK": "@cf/meta/llama-3.1-8b-instruct"
  },

  "observability": { "enabled": true }
}
